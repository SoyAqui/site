<IfModule mod_headers.c>
  # === Статика: long-term caching (1 год, immutable) ===
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|woff2?|ttf|eot|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # === HTML: must-revalidate (проверка при каждом визите) ===
  <FilesMatch "\.html?$">
    Header set Cache-Control "must-revalidate"
  </FilesMatch>

  # === Изображения контента (без ?v=): cache + revalidate ===
  # Если контентные изображения не имеют версии, даём им
  # moderate TTL, чтобы браузер не показывал устаревшие фото
  # навсегда. Контентные изображения с ?v= обрабатываются
  # выше (immutable).
  <FilesMatch "^(assets/images/news|assets/images/announcements)">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# === Сжатие ===
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
